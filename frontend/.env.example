# CivicLens frontend environment.
# Copy to `.env` — the real `.env` is never committed.
#
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# Never put a private key or any secret here (UI-CivicLens section 0.9).

# GenLayer Studio RPC API endpoint (default: https://studio.genlayer.com/api)
VITE_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Network identity, shown in the persistent network indicator.
VITE_GENLAYER_CHAIN_ID=61999
VITE_GENLAYER_CHAIN_NAME=GenLayer Studio
VITE_GENLAYER_SYMBOL=GEN

# Deployed CivicLens contract address (from `genlayer deploy`).
# LEAVE EMPTY to run the app against the bundled sample scenarios —
# every surface stays labeled "Sample data" until a real address is set.
#
# Current deployment (see docs/deployment.md):
#   contract 0x07d77BF87b8c76A0d6A6F925bAA18cae2f098B12 on studionet
#   deploy tx 0x0cf870f5fae52a57d97f19f0db7e94d6ad87f837345cd13d11ce7726fe319e4a
VITE_CONTRACT_ADDRESS=